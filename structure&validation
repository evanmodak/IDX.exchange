import pandas as pd
import os
import matplotlib.pyplot as plt

DATA_DIR = os.path.expanduser("~/Applications/IDXExchange/")
NA_VALS  = ["", "N/A", "n/a", "NULL", "null", "None", "none", "#N/A"]
KEEP_COLS = ["PropertyType", "ClosePrice", "LivingArea", "DaysOnMarket"]

def load_slim(path):
    header = pd.read_csv(path, nrows=0).columns.tolist()
    cols   = [c for c in KEEP_COLS if c in header]
    df = pd.read_csv(
        path,
        usecols=cols,
        dtype=str,
        keep_default_na=False,
        na_values=NA_VALS,
    )
    for col in ["ClosePrice", "LivingArea", "DaysOnMarket"]:
        if col in df.columns:
            df[col] = pd.to_numeric(df[col], errors="coerce")
    return df

listings = load_slim(os.path.join(DATA_DIR, "listings_residential_combined.csv"))
sold     = load_slim(os.path.join(DATA_DIR, "sold_residential_combined.csv"))

print(f"Listings loaded: {len(listings)} rows")
print(f"Sold loaded:     {len(sold)} rows")

print("\nUnique Property Types (Listings):")
print(listings["PropertyType"].value_counts(dropna=False))

print("\nUnique Property Types (Sold):")
print(sold["PropertyType"].value_counts(dropna=False))

FILTER_TYPE = "Residential"

listings_filtered = listings[listings["PropertyType"] == FILTER_TYPE].copy()
sold_filtered     = sold[sold["PropertyType"] == FILTER_TYPE].copy()

print(f"\nFiltering applied: PropertyType = '{FILTER_TYPE}'")
print(f"Listings after filter: {len(listings_filtered)}")
print(f"Sold after filter:     {len(sold_filtered)}")

def null_summary(df, name):
    null_count = df.isna().sum()
    null_pct   = null_count / len(df) * 100
    summary = pd.DataFrame({
        "column":     null_count.index,
        "null_count": null_count.values,
        "null_pct":   null_pct.values,
    }).sort_values("null_pct", ascending=False).reset_index(drop=True)
    out_path = os.path.join(DATA_DIR, f"{name}_null_summary.csv")
    summary.to_csv(out_path, index=False)
    print(f"Saved: {out_path}")
    return summary

listings_nulls = null_summary(listings_filtered, "listings")
sold_nulls     = null_summary(sold_filtered,     "sold")

print("\nTop null columns (Listings):")
print(listings_nulls.head(10))

def high_null_columns(summary_df):
    return summary_df[summary_df["null_pct"] > 90]

listings_high_null = high_null_columns(listings_nulls)
sold_high_null     = high_null_columns(sold_nulls)

print("\nColumns with >90% missing (Listings):")
print(listings_high_null)

print("\nColumns with >90% missing (Sold):")
print(sold_high_null)

listings_high_null.to_csv(os.path.join(DATA_DIR, "listings_high_null_columns.csv"), index=False)
sold_high_null.to_csv(    os.path.join(DATA_DIR, "sold_high_null_columns.csv"),     index=False)

def numeric_summary(df, name):
    cols = [c for c in ["ClosePrice", "LivingArea", "DaysOnMarket"] if c in df.columns]
    for col in cols:
        if not pd.api.types.is_numeric_dtype(df[col]):
            df[col] = pd.to_numeric(df[col], errors="coerce")
    summary = df[cols].describe(percentiles=[0.25, 0.5, 0.75, 0.9, 0.95]).T
    summary = summary.rename(columns={"25%": "p25", "50%": "median", "75%": "p75"})
    out_path = os.path.join(DATA_DIR, f"{name}_numeric_summary.csv")
    summary.to_csv(out_path)
    print(f"Saved: {out_path}")
    return summary

listings_numeric = numeric_summary(listings_filtered, "listings")
sold_numeric     = numeric_summary(sold_filtered,     "sold")

print("\nNumeric Summary (Listings):")
print(listings_numeric)

print("\nNumeric Summary (Sold):")
print(sold_numeric)

