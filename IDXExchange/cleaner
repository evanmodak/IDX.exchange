import pandas as pd
import os as os
 
DATA_DIR = os.path.expanduser("~/Applications/IDXExchange/")
 
sold = pd.read_csv(os.path.join(DATA_DIR, "sold_with_rates.csv"), low_memory=False)
listings = pd.read_csv(os.path.join(DATA_DIR, "listings_with_rates.csv"), low_memory=False)
 
print(f"Before: sold={len(sold):,}, listings={len(listings):,}")
 
def clean(df):
    # Date fields
    for col in ["CloseDate", "PurchaseContractDate", "ListingContractDate", "ContractStatusChangeDate"]:
        if col in df.columns:
            df[col] = pd.to_datetime(df[col], errors="coerce")
 
    # Numeric fields
    for col in ["ClosePrice", "LivingArea", "DaysOnMarket", "BedroomsTotal", "BathroomsTotalInteger", "Latitude", "Longitude"]:
        if col in df.columns:
            df[col] = pd.to_numeric(df[col], errors="coerce")
 
    # Invalid value flags
    if "ClosePrice" in df.columns:
        df["invalid_close_price_flag"] = df["ClosePrice"].notna() & (df["ClosePrice"] <= 0)
    if "LivingArea" in df.columns:
        df["invalid_living_area_flag"] = df["LivingArea"].notna() & (df["LivingArea"] <= 0)
    if "DaysOnMarket" in df.columns:
        df["invalid_dom_flag"] = df["DaysOnMarket"].notna() & (df["DaysOnMarket"] < 0)
    if "BedroomsTotal" in df.columns:
        df["invalid_bedrooms_flag"] = df["BedroomsTotal"].notna() & (df["BedroomsTotal"] < 0)
    if "BathroomsTotalInteger" in df.columns:
        df["invalid_bathrooms_flag"] = df["BathroomsTotalInteger"].notna() & (df["BathroomsTotalInteger"] < 0)
 
    # Date consistency flags
    if "ListingContractDate" in df.columns and "CloseDate" in df.columns:
        df["listing_after_close_flag"] = df["ListingContractDate"] > df["CloseDate"]
    if "PurchaseContractDate" in df.columns and "CloseDate" in df.columns:
        df["purchase_after_close_flag"] = df["PurchaseContractDate"] > df["CloseDate"]
    if "ListingContractDate" in df.columns and "PurchaseContractDate" in df.columns:
        df["negative_timeline_flag"] = df["ListingContractDate"] > df["PurchaseContractDate"]
 
    # Geographic flags
    if "Latitude" in df.columns and "Longitude" in df.columns:
        df["geo_missing_flag"] = df["Latitude"].isna() | df["Longitude"].isna()
        df["geo_zero_flag"] = (df["Latitude"] == 0) | (df["Longitude"] == 0)
        df["geo_positive_lon_flag"] = df["Longitude"].notna() & (df["Longitude"] > 0)
        df["geo_out_of_state_flag"] = (
            df["Latitude"].notna() & df["Longitude"].notna() &
            ~(df["Latitude"].between(32.5, 42.0) & df["Longitude"].between(-124.5, -114.1))
        )
 
    return df
 
sold     = clean(sold)
listings = clean(listings)
 
print(f"After:  sold={len(sold):,}, listings={len(listings):,}")
 
sold.to_csv(os.path.join(DATA_DIR, "sold_cleaned.csv"), index=False)
listings.to_csv(os.path.join(DATA_DIR, "listings_cleaned.csv"), index=False)
 
print("Done.")
 
